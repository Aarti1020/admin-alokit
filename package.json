{
  "name": "alokit-admin-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "clean": "node -e \"const fs=require('fs');['.next','out','hostinger-admin-static-deploy','tsconfig.tsbuildinfo'].forEach((path)=>fs.rmSync(path,{recursive:true,force:true}))\"",
    "build": "next build",
    "build:hostinger-admin-static": "npm run clean && next build && node scripts/prepare-hostinger-admin-static.mjs",
    "lint": "eslint"
  },
  "dependencies": {
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
